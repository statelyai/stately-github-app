# Existing GitHub App registration credentials. Never put these in a repository.
APP_ID=
# PEM text (quoted multiline in .env), escaped-newline PEM, or base64-encoded PEM.
PRIVATE_KEY=
# At least 32 bytes. Generate a random secret; use the same value in GitHub settings.
WEBHOOK_SECRET=

# Optional: disabled when blank. No Stately user/project key is needed.
# Production target: https://stately.ai/registry/api/github/documentation
STATELY_DOCUMENTATION_WEBHOOK_URL=

# Standalone HTTP listener; terminate TLS at a trusted reverse proxy.
HOST=127.0.0.1
PORT=3000
