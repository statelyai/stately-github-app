# The ID of your GitHub App
APP_ID=
WEBHOOK_SECRET=development

# Use `trace` to get verbose logging or `info` to show less
LOG_LEVEL=debug

# Go to https://smee.io/new set this to the URL that you are redirected to.
WEBHOOK_PROXY_URL=

# Optional. Reuses this app's verified events and webhook secret. No repository keys.
# Production target: https://stately.ai/registry/api/github/documentation
STATELY_DOCUMENTATION_WEBHOOK_URL=
