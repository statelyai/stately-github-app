{
  "name": "stately-github-app",
  "version": "1.0.0",
  "private": true,
  "description": "Stately GitHub webhooks and private PR machine diagrams",
  "author": "Matt Pocock <mattpocockvoice@gmail.com>",
  "license": "ISC",
  "homepage": "https://github.com/statelyai/stately-github-app",
  "keywords": [
    "github-app",
    "xstate",
    "stately"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && esbuild lib/parser-worker.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/parser-worker.cjs",
    "dev": "pnpm build && pnpm start",
    "start": "node --env-file-if-exists=.env dist/lib/server.js",
    "test": "pnpm build:vercel && tsc -p tsconfig.test.json && node --test --test-concurrency=1 .scratch/test-dist/test/*.test.js",
    "typecheck": "tsc --noEmit",
    "build:vercel": "pnpm build && node scripts/build-vercel.mjs"
  },
  "dependencies": {
    "@octokit/auth-app": "^8.3.0",
    "@octokit/rest": "^22.0.1",
    "@xstate/machine-extractor": "^0.16.0",
    "xstate": "^4.38.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "nock": "^15.0.6",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.1.3",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statelyai/stately-github-app.git"
  }
}
